# Student Satisfaction Project — variables d'environnement
#
# Exemple SANS secret réel.
# Django ne charge pas automatiquement .env.

# Développement local
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=

# HTTPS / reverse proxy
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0

# E-mail
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@student-satisfaction.local
SERVER_EMAIL=server@student-satisfaction.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10

# Exemple production — valeurs fictives
# DJANGO_ENV=production
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<clé-aléatoire-longue-et-secrète>
# DJANGO_ALLOWED_HOSTS=mon-domaine.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mon-domaine.example
# DATABASE_URL=postgresql://user:password@host:5432/database
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_TRUST_X_FORWARDED_PROTO=1
# DJANGO_HSTS_SECONDS=3600

# Portfolio public / modèle ML packagé — V17.2
PORTFOLIO_DEMO_ENABLED=0
PORTFOLIO_DEMO_USERNAME=portfolio-demo
PORTFOLIO_DEMO_EMAIL=portfolio-demo@example.invalid
PORTFOLIO_DEMO_PASSWORD=
PORTFOLIO_MODEL_PATH=deployment/model/portfolio_model.joblib

# Exemple production (mot de passe volontairement absent de ce fichier)
# PORTFOLIO_DEMO_ENABLED=1
# PORTFOLIO_DEMO_USERNAME=portfolio-demo
# PORTFOLIO_DEMO_EMAIL=portfolio-demo@example.invalid
# PORTFOLIO_DEMO_PASSWORD=<mot-de-passe-public-rotatable-defini-dans-la-plateforme>
# PORTFOLIO_MODEL_PATH=deployment/model/portfolio_model.joblib

# V17.4 — Vercel + Neon
# Activer "Automatically expose System Environment Variables" dans Vercel.
# DATABASE_URL est normalement la connexion Neon poolée.
# DATABASE_URL_UNPOOLED peut être fournie par l'intégration pour les migrations.
DATABASE_URL_UNPOOLED=
DJANGO_DB_CONN_MAX_AGE=
